
@page
@model Costin_Catalina_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Category)
        {
            string selectedRow = "";

            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @item.CategoryName
                </td>

                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">Select</a> |

                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryID != 0)
{
    <h3>Books in Selected Category</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Author</th>
                <th>Publisher</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>
                        @book.Title
                    </td>

                    <td>
                        @(book.Author?.FullName ?? "")
                    </td>

                    <td>
                        @(book.Publisher?.PublisherName ?? "")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Books.Any())
    {
        <p>Nu există cărți în această categorie.</p>
    }

    <a asp-page="./Index">Back to full List</a>
}
